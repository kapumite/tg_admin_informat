@echo off
chcp 65001 >nul
REM =============================================================================
REM  start_system.bat — Автоматический запуск агента на ПК студента
REM  Размещение: в одной папке с student_agent.py и config.py
REM =============================================================================

title Агент управления классом

echo ============================================================
echo   Система управления компьютерным классом
echo   Запуск агента на рабочей станции
echo ============================================================
echo.

REM --- Переход в папку скрипта ---
cd /d "%~dp0"

REM --- Проверка наличия Python ---
python --version >nul 2>&1
if errorlevel 1 (
    echo [ОШИБКА] Python не найден. Установите Python 3.9 или выше.
    echo          Загрузка: https://www.python.org/downloads/
    pause
    exit /b 1
)

REM --- Создание виртуального окружения (если ещё не создано) ---
if not exist "venv\" (
    echo [ИНФО] Создание виртуального окружения Python...
    python -m venv venv
    if errorlevel 1 (
        echo [ОШИБКА] Не удалось создать виртуальное окружение.
        pause
        exit /b 1
    )
    echo [ИНФО] Виртуальное окружение создано успешно.
    echo.
)

REM --- Активация виртуального окружения ---
echo [ИНФО] Активация виртуального окружения...
call venv\Scripts\activate.bat

REM --- Установка / обновление зависимостей ---
echo [ИНФО] Проверка и установка зависимостей...
pip install -r requirements.txt --quiet --no-input
if errorlevel 1 (
    echo [ОШИБКА] Не удалось установить зависимости.
    echo          Проверьте подключение к интернету.
    pause
    exit /b 1
)
echo [ИНФО] Зависимости установлены.
echo.

REM --- Проверка наличия config.py ---
if not exist "config.py" (
    echo [ОШИБКА] Файл config.py не найден!
    echo          Скопируйте config.py в эту же папку и заполните токен.
    pause
    exit /b 1
)

REM --- Запуск агента ---
echo [ИНФО] Запуск агента рабочей станции...
echo ============================================================
echo.
python student_agent.py

REM --- Если агент завершился ---
echo.
echo [ИНФО] Агент остановлен.
pause
